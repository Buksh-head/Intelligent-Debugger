# Copy to .env and fill in real values locally. Never commit .env.
# Shared Supabase Postgres instance (project ref: wqfpnncfzhgkidgbpngd) so the
# whole team reads/writes the same data instead of separate local databases.
# Get the real password from Project Settings -> Database in the Supabase
# dashboard - do not put the real password in .env.example, only in your own
# untracked .env.
# Use the shared pooler host below, not the direct host
# (db.wqfpnncfzhgkidgbpngd.supabase.co): the direct host is IPv6 only and
# fails to resolve from Docker on most networks.
DATABASE_URL=postgresql://postgres.wqfpnncfzhgkidgbpngd:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
GROQ_API_TOKEN=[Your Groq API Token Here]
PISTON_URL=http://piston:2000
GROQ_API_URL=https://api.groq.com/openai/v1
# The Groq API key used for the instructor dashboard's AI insights
# (insight_generator.py). It can be the same key as GROQ_API_TOKEN.
INSTRUCTOR_TOKEN=[Your Groq API Token Here]

# Instructor authentication (Supabase Auth). VITE_SUPABASE_ANON_KEY is from
# the Supabase dashboard -> Project Settings -> API, and is safe to expose
# client-side by design (that's how Supabase's anon key works).
# SUPABASE_URL (same URL, no dashboard lookup needed) lets the backend fetch
# Supabase's public JWKS to verify instructor JWTs (ES256), no shared secret
# involved.
VITE_SUPABASE_URL=https://wqfpnncfzhgkidgbpngd.supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_URL=https://wqfpnncfzhgkidgbpngd.supabase.co

# Production frontend builds only: the API's address. Leave it unset locally,
# where the Vite dev server forwards /api to the backend instead.
# VITE_API_URL=https://your-backend.vercel.app
